# =============================================================================
# CampusMind Python Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# Google OAuth 2.0 — Get from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT — Use a strong random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Google Gemini / Groq API Key
GEMINI_API_KEY=your-gemini-or-groq-api-key

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# CORS
FRONTEND_URL=http://localhost:3000

# Environment
ENVIRONMENT=development
